# Copy to .env and fill in the values there. Never commit .env.

# PostgreSQL 16 connection string, used by the API and the worker
DATABASE_URL=
# Redis connection string for the BullMQ queue
REDIS_URL=
# HS256 signing secret for JWTs; tests use their own test-only value
JWT_SECRET=
# Gemini free-tier key, no billing account attached; never passed to the sandbox
GEMINI_API_KEY=
# Port the API listens on
PORT=
